# Backend server
API_HOST=127.0.0.1
API_PORT=8080

# Google OAuth app credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/auth/callback

# Optional: app deep-link handoff target after OAuth callback
# Android-first deep link example used by this Flutter app.
APP_REDIRECT_URI=jilr://oauth-complete

# Storage
TOKEN_DB_PATH=data/tokens.sqlite3

# Safety controls
MAX_DAILY_SEND=2000

# Safaricom Daraja (M-Pesa STK Push)
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
# Must be a reachable HTTPS callback URL in most Daraja setups.
DARAJA_CALLBACK_URL=
